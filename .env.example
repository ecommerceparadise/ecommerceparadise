# Google Ads API credentials — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# From: Manager account (MCC) -> Admin -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# From: credentials.json (Google Cloud -> APIs & Services -> Credentials -> Desktop app)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# From: python scripts/get_refresh_token.py  (run once, on a machine with a browser)
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) account ID, 10 digits, NO dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# The account you actually operate on, 10 digits, NO dashes
GOOGLE_ADS_CUSTOMER_ID=
