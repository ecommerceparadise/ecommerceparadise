# Google Ads API credentials — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# From: Manager account (MCC) -> Admin -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# From: Google Cloud -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# From the OAuth Playground flow (see README). Grants real account access —
# treat it like a password.
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) account ID, 10 digits, NO dashes.
# One set of credentials reaches every client account linked under it.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# OPTIONAL. A default operating account, only if you usually work on one.
# Normally left blank: the client account is named per request, and
# google_ads.accounts.resolve_account maps a client name to its ID.
GOOGLE_ADS_CUSTOMER_ID=
